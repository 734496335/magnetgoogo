{
  "manifest_version": 3,
  "name": "MagnetGoogo Cookie Bridge",
  "version": "1.0",
  "description": "Auto-submits verification cookies back to MagnetGoogo search",
  "permissions": ["cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
