# Production alert delivery configuration.
# Copy to /etc/magnet-alerts/alert.env and chmod 0600.

# Preferred: Alibaba CloudMonitor external-alert endpoint (email delivery is configured in CloudMonitor contact group).
MAGNET_ALERT_CLOUDMONITOR_URL=
MAGNET_ALERT_CLOUDMONITOR_SECURITY_WORD=

# Optional fallback: QQ Mail SMTP authorization code (NOT the QQ login password).
MAGNET_ALERT_TO=alerts@example.com
MAGNET_ALERT_SMTP_USER=alerts@example.com
MAGNET_ALERT_SMTP_AUTH_CODE=
MAGNET_ALERT_SMTP_HOST=smtp.qq.com
MAGNET_ALERT_SMTP_PORT=465
