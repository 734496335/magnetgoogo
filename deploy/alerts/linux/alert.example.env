# Keep disabled until a private transport is configured.
MAGNET_ALERT_TRANSPORT=disabled
MAGNET_ALERT_XTUIS_TOKEN=
MAGNET_ALERT_OUTBOX_DB=/var/lib/magnet-alerts/xtuis.sqlite3
# Per-host budgets: production Aliyun=50 and Oracle=150 (combined < 300/day).
MAGNET_ALERT_XTUIS_DAILY_LIMIT=100
MAGNET_ALERT_XTUIS_PER_MINUTE=10
MAGNET_ALERT_XTUIS_STATUS_PER_MINUTE=4
MAGNET_ALERT_CLOUDMONITOR_URL=
MAGNET_ALERT_CLOUDMONITOR_SECURITY_WORD=
MAGNET_ALERT_CLOUDMONITOR_ACCESS_KEY_ID=
MAGNET_ALERT_CLOUDMONITOR_ACCESS_KEY_SECRET=
MAGNET_ALERT_SMTP_USER=
MAGNET_ALERT_SMTP_AUTH_CODE=
MAGNET_ALERT_TO=
MAGNET_ALERT_SMTP_HOST=smtp.qq.com
MAGNET_ALERT_SMTP_PORT=465
