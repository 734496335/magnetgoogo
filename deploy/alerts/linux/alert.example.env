# Production alert delivery configuration.
# Copy to /etc/magnet-alerts/alert.env and chmod 0600.

# Explicitly enable one transport only after credentials are configured.
# Values: disabled | cloudmonitor | smtp | auto
MAGNET_ALERT_TRANSPORT=disabled

# Alibaba CloudMonitor external-alert endpoint. The URL/token is secret and must remain
# only in this root-readable file. For Security Word mode leave AccessKey fields blank;
# for Basic Auth mode fill both AccessKey fields.
MAGNET_ALERT_CLOUDMONITOR_URL=
MAGNET_ALERT_CLOUDMONITOR_ACCESS_KEY_ID=
MAGNET_ALERT_CLOUDMONITOR_ACCESS_KEY_SECRET=
MAGNET_ALERT_CLOUDMONITOR_SECURITY_WORD=

# QQ Mail SMTP fallback. Use a QQ Mail SMTP authorization code, NOT the QQ login password.
MAGNET_ALERT_TO=alerts@example.com
MAGNET_ALERT_SMTP_USER=alerts@example.com
MAGNET_ALERT_SMTP_AUTH_CODE=
MAGNET_ALERT_SMTP_HOST=smtp.qq.com
MAGNET_ALERT_SMTP_PORT=465
