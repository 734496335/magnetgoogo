{
  "$schema": "../../../cf-gateway/node_modules/wrangler/config-schema.json",
  "name": "magnetgoogo-media-production-uploader",
  "main": "../r2-upload-worker/worker.mjs",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "vars": {
    "PUBLISH_MODE": "production-data"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "magnetgoogo-media"
    }
  ]
}
