[Unit]
Description=MagnetGoogo Oracle media compute-only job
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
RequiresMountsFor=/var/lib/magnet-media

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/magnet-media/app
EnvironmentFile=-/etc/magnet-media/runtime.env
ExecStart=/usr/bin/bash /opt/magnet-media/app/deploy/resource-index/linux/run-media-daily.sh compute
ExecStopPost=-/usr/bin/bash /opt/magnet-media/app/deploy/resource-index/linux/cleanup-media-container.sh compute
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/magnet-media /run

[Install]
WantedBy=multi-user.target
