[Unit]
Description=MagnetGoogo media outbox tunnel from Aliyun to Oracle
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
Group=admin
ExecStart=/usr/bin/ssh -N -i /home/admin/.ssh/travel-oracle-tunnel -o BatchMode=yes -o StrictHostKeyChecking=yes -o ExitOnForwardFailure=yes -o Compression=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:18766:127.0.0.1:18766 ubuntu@161.153.78.129
Restart=always
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/admin/.ssh

[Install]
WantedBy=multi-user.target
