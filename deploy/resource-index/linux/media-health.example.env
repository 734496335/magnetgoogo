MAGNET_MEDIA_HEALTH_ROLE=disabled
MAGNET_MEDIA_HEALTH_STATUS_FILE=
MAGNET_MEDIA_HEALTH_MAX_AGE_HOURS=30
MAGNET_MEDIA_HEALTH_STATE_DIR=/var/lib/magnet-alerts
MAGNET_ALERT_BIN=/opt/magnet-alerts/magnet-alert.py
# Finalizer only: alert at 80% of the limit read from installed publisher source.
MAGNET_MEDIA_HEALTH_PUBLIC_ROOT=/var/lib/magnet-media/public
MAGNET_MEDIA_HEALTH_PUBLISHER_SOURCE=/opt/magnet-media-finalizer/app/magnet/resource_index/publish/worker_bridge.py
