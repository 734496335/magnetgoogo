[Unit]
Description=MagnetGoogo daily media production publish
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/magnet-media/app
ExecStart=/opt/magnet-media/app/deploy/resource-index/linux/run-media-daily.sh publish
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/magnet-media /run /var/log

[Install]
WantedBy=multi-user.target
