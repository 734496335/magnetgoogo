[Unit]
Description=MagnetGoogo weekly Oracle media compute handoff audit
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/magnet-media-finalizer/app
EnvironmentFile=-/etc/magnet-media/finalizer.env
ExecStart=/usr/bin/bash /opt/magnet-media-finalizer/app/deploy/resource-index/linux/run-media-compute-audit.sh
TimeoutStartSec=2h
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/magnet-media /run /var/log
