[Unit]
Description=MagnetGoogo Oracle media shadow candidate
After=docker.service network-online.target var-lib-magnet\x2dmedia.mount
Wants=network-online.target
Requires=docker.service var-lib-magnet\x2dmedia.mount

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/magnet-media/app
EnvironmentFile=-/etc/magnet-media/runtime.env
ExecStart=/usr/bin/bash /opt/magnet-media/app/deploy/resource-index/linux/run-media-daily.sh candidate
ExecStopPost=-/usr/bin/bash /opt/magnet-media/app/deploy/resource-index/linux/cleanup-media-container.sh candidate
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/magnet-media /run

[Install]
WantedBy=multi-user.target
