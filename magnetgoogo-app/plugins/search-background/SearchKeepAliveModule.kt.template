package __PACKAGE__

import android.content.Intent
import android.os.Build
import android.util.Log
import com.facebook.react.HeadlessJsTaskService
import com.facebook.react.bridge.Promise
import com.facebook.react.bridge.ReactApplicationContext
import com.facebook.react.bridge.ReactContextBaseJavaModule
import com.facebook.react.bridge.ReactMethod

class SearchKeepAliveModule(private val reactContext: ReactApplicationContext) :
  ReactContextBaseJavaModule(reactContext) {

  companion object {
    private const val TAG = "SearchKeepAlive"

    @Volatile
    private var latestKeepAliveToken: Int = 0

    @Synchronized
    private fun markKeepAliveStart(token: Int) {
      latestKeepAliveToken = token
    }

    @Synchronized
    private fun claimKeepAliveStop(token: Int): Boolean {
      if (token <= 0 || latestKeepAliveToken != token) return false
      latestKeepAliveToken = 0
      return true
    }
  }

  override fun getName(): String = "SearchKeepAlive"

  @ReactMethod
  fun start(title: String, text: String, token: Double, promise: Promise) {
    val tokenInt = token.toInt()
    try {
      markKeepAliveStart(tokenInt)
      Log.i(TAG, "start keepalive token=$tokenInt")
      val intent = Intent(reactContext, SearchKeepAliveService::class.java).apply {
        action = SearchKeepAliveService.ACTION_START
        putExtra(SearchKeepAliveService.EXTRA_TITLE, title)
        putExtra(SearchKeepAliveService.EXTRA_TEXT, text)
        putExtra(SearchKeepAliveService.EXTRA_TOKEN, tokenInt)
      }
      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
        reactContext.startForegroundService(intent)
      } else {
        reactContext.startService(intent)
      }
      promise.resolve(true)
    } catch (e: Exception) {
      claimKeepAliveStop(tokenInt)
      promise.reject("E_KEEPALIVE_START", e)
    }
  }

  @ReactMethod
  fun handoff(query: String, token: Double, searchId: String, promise: Promise) {
    val tokenInt = token.toInt()
    try {
      markKeepAliveStart(tokenInt)
      Log.i(TAG, "handoff background search query=$query token=$tokenInt")
      val keepAliveIntent = Intent(reactContext, SearchKeepAliveService::class.java).apply {
        action = SearchKeepAliveService.ACTION_START
        putExtra(SearchKeepAliveService.EXTRA_TITLE, "Search in progress")
        putExtra(SearchKeepAliveService.EXTRA_TEXT, "Finishing \"$query\" in background")
        putExtra(SearchKeepAliveService.EXTRA_TOKEN, tokenInt)
      }
      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
        reactContext.startForegroundService(keepAliveIntent)
      } else {
        reactContext.startService(keepAliveIntent)
      }

      HeadlessJsTaskService.acquireWakeLockNow(reactContext)
      val headlessIntent = Intent(reactContext, SearchHeadlessService::class.java).apply {
        putExtra(SearchHeadlessService.EXTRA_QUERY, query)
        putExtra(SearchHeadlessService.EXTRA_TOKEN, tokenInt)
        putExtra(SearchHeadlessService.EXTRA_SEARCH_ID, searchId)
      }
      reactContext.startService(headlessIntent)
      promise.resolve(true)
    } catch (e: Exception) {
      promise.reject("E_KEEPALIVE_HANDOFF", e)
    }
  }

  @ReactMethod
  fun stop(token: Double, promise: Promise) {
    val tokenInt = token.toInt()
    try {
      Log.i(TAG, "stop keepalive token=$tokenInt")
      val headlessStopIntent = Intent(reactContext, SearchHeadlessService::class.java).apply {
        action = SearchHeadlessService.ACTION_STOP
        putExtra(SearchHeadlessService.EXTRA_TOKEN, tokenInt)
      }
      try {
        reactContext.startService(headlessStopIntent)
      } catch (e: Exception) {
        Log.w(TAG, "headless stop failed token=$tokenInt", e)
      }

      if (!claimKeepAliveStop(tokenInt)) {
        Log.i(TAG, "ignore duplicate/stale keepalive stop token=$tokenInt")
        promise.resolve(true)
        return
      }

      val intent = Intent(reactContext, SearchKeepAliveService::class.java).apply {
        action = SearchKeepAliveService.ACTION_STOP
        putExtra(SearchKeepAliveService.EXTRA_TOKEN, tokenInt)
      }
      reactContext.startService(intent)
      promise.resolve(true)
    } catch (e: Exception) {
      promise.reject("E_KEEPALIVE_STOP", e)
    }
  }
}
