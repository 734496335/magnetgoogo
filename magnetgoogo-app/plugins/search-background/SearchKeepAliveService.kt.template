package __PACKAGE__

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.app.Service
import android.content.Context
import android.content.Intent
import android.os.Build
import android.os.IBinder
import android.os.PowerManager
import android.util.Log
import androidx.core.app.NotificationCompat

class SearchKeepAliveService : Service() {
  companion object {
    private const val TAG = "SearchKeepAliveService"
    const val CHANNEL_ID = "search-running"
    const val NOTIFICATION_ID = 20041
    const val ACTION_START = "__PACKAGE__.SEARCH_KEEPALIVE_START"
    const val ACTION_STOP = "__PACKAGE__.SEARCH_KEEPALIVE_STOP"
    const val EXTRA_TITLE = "title"
    const val EXTRA_TEXT = "text"
    const val EXTRA_TOKEN = "token"
  }

  private var wakeLock: PowerManager.WakeLock? = null
  private var activeToken: Int = 0

  override fun onCreate() {
    super.onCreate()
    ensureChannel()
    // Satisfy Android's foreground-service deadline before any queued start/stop race is processed.
    startForeground(
      NOTIFICATION_ID,
      buildNotification("Search in progress", "Preparing background search"),
    )
    acquireWakeLock()
  }

  override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
    if (intent?.action == ACTION_STOP) {
      val requestedToken = intent.getIntExtra(EXTRA_TOKEN, 0)
      if (requestedToken != 0 && activeToken != 0 && requestedToken != activeToken) {
        Log.i(TAG, "ignore stale stop token=$requestedToken active=$activeToken startId=$startId")
        return START_NOT_STICKY
      }

      // Do not let an older stop tear down a newer queued start for this same service.
      val stopped = stopSelfResult(startId)
      if (stopped) {
        Log.i(TAG, "stop foreground token=$requestedToken active=$activeToken startId=$startId")
        activeToken = 0
        stopForeground(STOP_FOREGROUND_REMOVE)
      } else {
        Log.i(TAG, "ignore superseded stop token=$requestedToken active=$activeToken startId=$startId")
      }
      return START_NOT_STICKY
    }

    val requestedToken = intent?.getIntExtra(EXTRA_TOKEN, 0) ?: 0
    if (requestedToken != 0) activeToken = requestedToken
    val title = intent?.getStringExtra(EXTRA_TITLE) ?: "Search in progress"
    val text = intent?.getStringExtra(EXTRA_TEXT) ?: "Keeping search active"
    startForeground(NOTIFICATION_ID, buildNotification(title, text))
    Log.i(TAG, "foreground active token=$activeToken startId=$startId")
    return START_NOT_STICKY
  }

  override fun onDestroy() {
    activeToken = 0
    releaseWakeLock()
    super.onDestroy()
  }

  override fun onBind(intent: Intent?): IBinder? = null

  private fun ensureChannel() {
    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
    val manager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    val channel = NotificationChannel(
      CHANNEL_ID,
      "Search activity",
      NotificationManager.IMPORTANCE_LOW,
    ).apply {
      description = "Keeps active searches running while the app is in background"
      setShowBadge(false)
    }
    manager.createNotificationChannel(channel)
  }

  private fun buildNotification(title: String, text: String): Notification {
    val launchIntent = packageManager.getLaunchIntentForPackage(packageName)
    val pendingIntent = PendingIntent.getActivity(
      this,
      0,
      launchIntent,
      PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
    )

    return NotificationCompat.Builder(this, CHANNEL_ID)
      .setSmallIcon(R.mipmap.ic_launcher)
      .setContentTitle(title)
      .setContentText(text)
      .setContentIntent(pendingIntent)
      .setOngoing(true)
      .setOnlyAlertOnce(true)
      .setCategory(NotificationCompat.CATEGORY_SERVICE)
      .setPriority(NotificationCompat.PRIORITY_LOW)
      .build()
  }

  private fun acquireWakeLock() {
    try {
      val powerManager = getSystemService(Context.POWER_SERVICE) as PowerManager
      wakeLock = powerManager.newWakeLock(
        PowerManager.PARTIAL_WAKE_LOCK,
        "MagGoogo:SearchKeepAlive",
      ).apply {
        setReferenceCounted(false)
        acquire(2 * 60 * 60 * 1000L)
      }
    } catch (_: Throwable) {
    }
  }

  private fun releaseWakeLock() {
    try {
      wakeLock?.let {
        if (it.isHeld) it.release()
      }
    } catch (_: Throwable) {
    } finally {
      wakeLock = null
    }
  }
}
